{
  "name": "blog",
  "private": true,
  "type": "module",
  "scripts": {
    "update-deps": "bunx @astrojs/upgrade && bunx npm-check-updates -u && bun install",
    "build": "bun run redirects:generate && astro build",
    "check": "astro check",
    "content:generate": "bun run redirects:generate",
    "lint": "vp check",
    "format": "vp check --fix",
    "test": "bun test",
    "deploy": "bun run build && bunx wrangler build --x-new-config --x-cf-build-output && bunx cf deploy --prebuilt --dry-run && bunx cf deploy --prebuilt",
    "deploy:dry-run": "bun run build && bunx wrangler build --x-new-config --x-cf-build-output && bunx cf deploy --prebuilt --dry-run",
    "dev": "bun run redirects:generate && astro dev",
    "preview": "astro preview",
    "redirects:generate": "bun scripts/generate-hatena-pagination-redirects.ts",
    "new-post": "bun scripts/create-article.ts",
    "x-post": "bun scripts/generate-x-post-text.ts",
    "x-card": "bun scripts/generate-x-card-images.ts"
  },
  "dependencies": {
    "astro": "7.4.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "^0.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "cf": "^1.0.0-beta.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-plus": "1.1.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.0"
}
